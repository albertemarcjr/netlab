# Copy this file to .env and put real values there. .env is gitignored; this file is not.
# Never put real secrets in this file.

# Postgres (services/docker-compose.yml, notebook 03 §F)
POSTGRES_USER=netlab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=netlab
POSTGRES_PORT=5432

# Optional: set to use Postgres instead of SQLite in scripts/collect.py (notebook 03 §I)
# DATABASE_URL=postgresql://netlab:change-me@127.0.0.1:5432/netlab

# Inventory API location (notebook 03 §C, §H, §I)
INVENTORY_URL=http://127.0.0.1:8000

# Optional: GitHub personal access token for authenticated API calls (notebook 03 §D)
GITHUB_TOKEN=ghp_fake_example_token_do_not_use
